{
  "name": "kotoba-lab",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.1 <23"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "test": "node --import tsx --test tests/*.test.cjs tests/*.test.mjs tests/*.test.ts",
    "test:browser": "playwright test",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-database.mjs",
    "format:check": "prettier --check src scripts tests next.config.mjs playwright.config.cjs vercel.json package.json .prettierrc.json",
    "preview": "next start --hostname 127.0.0.1 --port 4173",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-database.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-database.mjs",
    "contracts:generate": "tsx scripts/generate-openapi.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "dompurify": "3.3.1",
    "marked": "17.0.0",
    "mermaid": "11.12.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

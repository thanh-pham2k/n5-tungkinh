{
  "name": "kotoba-lab",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.1 <23"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "pretest": "node scripts/prepare-assets.mjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:browser": "playwright test",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-database.mjs",
    "format:check": "prettier --check src scripts tests next.config.mjs playwright.config.cjs vercel.json package.json .prettierrc.json",
    "preview": "node scripts/serve-static.mjs"
  },
  "dependencies": {
    "dompurify": "3.3.1",
    "marked": "17.0.0",
    "mermaid": "11.12.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  }
}
